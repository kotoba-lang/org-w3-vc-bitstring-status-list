{:paths ["src"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/io-multiformats
        {:git/url "https://github.com/kotoba-lang/io-multiformats.git"
         :git/sha "37843825a77bc6b74f4a1882471d252f6f931f58"}
        io.github.kotoba-lang/org-ietf-deflate
        {:git/url "https://github.com/kotoba-lang/org-ietf-deflate.git"
         :git/sha "430d754313e9082114ec00554e0b6770d9d318c5"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      ;; TEST-ONLY. Parity compiles
                      ;; kotoba/status_list/check.kotoba and runs it against
                      ;; status-list.core. Nothing in :paths depends on
                      ;; either. Pins are the west pair (amu + kotoba-kir)
                      ;; as of this commit; advanced together.
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "35e8a18f2842762bedbf88b32f22e1128ad95cf0"}
                      io.github.kotoba-lang/osaho
                      {:git/url "https://github.com/kotoba-lang/osaho.git"
                       :git/sha "099c627609ad506babf05f2d5e9a73b95c1b026b"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}
  ;; West/sibling workspace development only. Release and CI never use this.
  :dev {:override-deps
        {io.github.kotoba-lang/io-multiformats {:local/root "../io-multiformats"}
         io.github.kotoba-lang/org-ietf-deflate {:local/root "../org-ietf-deflate"}}}}}
